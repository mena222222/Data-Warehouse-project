
TRUNCATE TABLE silver.crm_cust_info;

INSERT INTO silver.crm_cust_info
(
    cst_id,
    cst_key,
    cst_firstname,
    cst_lastname,
    cst_marital_status,
    cst_gndr,
    cst_create_date
)
SELECT
    cst_id,
    cst_key,

    -- Clean Customer Names
    TRIM(cst_firstname) AS cst_firstname,
    TRIM(cst_lastname)  AS cst_lastname,

    -- Normalize Marital Status
    CASE
        WHEN UPPER(TRIM(cst_marital_status)) = 'S' THEN 'Single'
        WHEN UPPER(TRIM(cst_marital_status)) = 'M' THEN 'Married'
        ELSE 'N/A'
    END AS cst_marital_status,

    -- Normalize Gender
    CASE
        WHEN UPPER(TRIM(cst_gndr)) = 'M' THEN 'Male'
        WHEN UPPER(TRIM(cst_gndr)) = 'F' THEN 'Female'
        ELSE 'N/A'
    END AS cst_gndr,

    cst_create_date

FROM
(
    SELECT
        *,
        ROW_NUMBER() OVER (
            PARTITION BY cst_id
            ORDER BY cst_create_date DESC
        ) AS flag_last
    FROM bronze.crm_cust_info
    WHERE cst_id IS NOT NULL
) AS t1

WHERE flag_last = 1
   OR LEN(cst_key) <> 10;

-----------------------------------------------------------------------------
TRUNCATE TABLE silver.crm_prd_info;

INSERT INTO silver.crm_prd_info
(
    prd_id,
    cat_id,
    prd_key,
    prd_nm,
    prd_cost,
    prd_line,
    prd_start_dt,
    prd_end_dt
)
SELECT
    prd_id,

    -- Extract Category ID
    REPLACE(
        SUBSTRING(TRIM(prd_key), 1, 5),
        '-',
        '_'
    ) AS cat_id,

    -- Extract Product Key
    SUBSTRING(
        TRIM(prd_key),
        7,
        LEN(prd_key)
    ) AS prd_key,

    prd_nm,

    -- Handle NULL Product Cost
    CASE
        WHEN prd_cost IS NULL THEN 0
        ELSE prd_cost
    END AS prd_cost,

    -- Normalize Product Line
    CASE
        WHEN UPPER(TRIM(prd_line)) = 'M' THEN 'Mountain'
        WHEN UPPER(TRIM(prd_line)) = 'R' THEN 'Road'
        WHEN UPPER(TRIM(prd_line)) = 'S' THEN 'Other Sales'
        WHEN UPPER(TRIM(prd_line)) = 'T' THEN 'Touring'
        ELSE 'N/A'
    END AS prd_line,

    prd_start_dt,

    -- Calculate Product End Date
    LEAD(prd_start_dt) OVER (
        PARTITION BY prd_key
        ORDER BY prd_start_dt
    ) - 1 AS prd_end_dt

FROM bronze.crm_prd_info;
-------------------------------------------------------------------------

TRUNCATE TABLE silver.crm_sales_details;

INSERT INTO silver.crm_sales_details
(
    sls_ord_num,
    sls_prd_key,
    sls_cust_id,
    sls_order_dt,
    sls_ship_dt,
    sls_due_dt,
    sls_sales,
    sls_quantity,
    sls_price
)
SELECT
    sls_ord_num,
    sls_prd_key,
    sls_cust_id,

    -- Convert Order Date
    CASE
        WHEN LEN(sls_order_dt) <> 8
          OR sls_order_dt = 0
            THEN NULL
        ELSE CAST(CAST(sls_order_dt AS NVARCHAR) AS DATE)
    END AS sls_order_dt,

    -- Convert Shipping Date
    CASE
        WHEN LEN(sls_ship_dt) <> 8
          OR sls_ship_dt = 0
            THEN NULL
        ELSE CAST(CAST(sls_ship_dt AS NVARCHAR) AS DATE)
    END AS sls_ship_dt,

    -- Convert Due Date
    CASE
        WHEN LEN(sls_due_dt) <> 8
          OR sls_due_dt = 0
            THEN NULL
        ELSE CAST(CAST(sls_due_dt AS NVARCHAR) AS DATE)
    END AS sls_due_dt,

    -- Validate Sales Amount
    CASE
        WHEN sls_sales <= 0
          OR sls_sales IS NULL
          OR sls_sales <> sls_quantity * ABS(sls_price)
            THEN sls_quantity * ABS(sls_price)
        ELSE sls_sales
    END AS sls_sales,

    sls_quantity,

    -- Validate Product Price
    CASE
        WHEN sls_price <= 0
          OR sls_price IS NULL
          OR sls_price <> sls_sales / sls_quantity
            THEN sls_sales / NULLIF(sls_quantity, 0)
        ELSE sls_price
    END AS sls_price

FROM bronze.crm_sales_details;
---------------------------------------------------------------------------------

TRUNCATE TABLE silver.erp_cust_az12;

INSERT INTO silver.erp_cust_az12
(
    cid,
    bdate,
    gen
)
SELECT
    -- Clean Customer ID
    CASE
        WHEN LEN(cid) > 10
            THEN SUBSTRING(cid, 4, LEN(cid))
        ELSE cid
    END AS cid,

    -- Validate Birth Date
    CASE
        WHEN bdate > GETDATE()
          OR bdate < '1926-01-01'
            THEN NULL
        ELSE bdate
    END AS bdate,

    -- Normalize Gender
    CASE
        WHEN UPPER(TRIM(gen)) IN ('M', 'MALE')
            THEN 'Male'
        WHEN UPPER(TRIM(gen)) IN ('F', 'FEMALE')
            THEN 'Female'
        ELSE 'N/A'
    END AS gen

FROM bronze.erp_cust_az12;
-----------------------------------------------------------------------------

TRUNCATE TABLE silver.erp_loc_a101;

INSERT INTO silver.erp_loc_a101
(
    cid,
    cntry
)
SELECT
    -- Clean Customer ID
    REPLACE(cid, '-', '') AS cid,

    -- Normalize Country Names
    CASE
        WHEN UPPER(TRIM(cntry)) = 'DE'
            THEN 'Germany'
        WHEN UPPER(TRIM(cntry)) IN ('USA', 'US')
            THEN 'United states'
        WHEN cntry IS NULL OR cntry = ''
            THEN 'N/A'
        ELSE cntry
    END AS cntry

FROM bronze.erp_loc_a101;
----------------------------------------------------------------------

TRUNCATE TABLE silver.erp_px_cat_g1v2;

INSERT INTO silver.erp_px_cat_g1v2
(
    id,
    cat,
    subcat,
    maintenance
)
SELECT
    id,
    cat,
    subcat,
    maintenance
FROM bronze.erp_px_cat_g1v2;
